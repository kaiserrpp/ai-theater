{
  "expo": {
    "name": "AI-Theatre",
    "slug": "ai-theatre",
    "version": "2026.11.225",
    "orientation": "portrait",
    "icon": "./assets/images/caras-teatro.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaiserrpp.aitheatre.prototype",
      "buildNumber": "2",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permite reconocer tus palabras para el modo Inteligente.",
        "NSMicrophoneUsageDescription": "Permite el micrófono para ensayar tus réplicas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/caras-teatro.png",
        "backgroundColor": "#5f0c14"
      },
      "package": "com.kaiserrpp.aitheatre.prototype",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/caras-teatro.png",
      "bundler": "metro",
      "pwa": {
        "display": "standalone",
        "orientation": "portrait",
        "themeColor": "#faf9f7",
        "manifest": {
          "short_name": "AI-Theatre",
          "start_url": "/"
        }
      }
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite el micrófono para ensayar tus réplicas.",
          "speechRecognitionPermission": "Permite reconocer tus palabras para el modo Inteligente.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "extra": {
      "nativePrototype": {
        "webUrl": "https://ai-theater.vercel.app/?share=d92b33981047&nativePrototype=1",
        "bridgeProtocol": 1
      },
      "eas": {
        "projectId": "7f254bd3-5532-490c-8114-a149d7c28132"
      }
    },
    "owner": "kaiserpps-team"
  }
}
