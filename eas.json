{
  "cli": { "version": ">= 27.9.0", "appVersionSource": "local" },
  "build": {
    "beta": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "android": { "buildType": "app-bundle", "resourceClass": "medium" }
    },
    "prototype": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "ios-validation": {
      "extends": "prototype",
      "ios": { "simulator": true }
    }
  },
  "submit": {
    "beta": { "android": { "track": "alpha", "releaseStatus": "draft" } }
  }
}
